#!/usr/bin/env python3
import argparse
import json
import re
import sys


CAP_KEYS = [
    "levelCap100",
    "levelCap200",
    "levelCap300",
    "levelCap400",
    "levelCap100Courses",
    "levelCap200Courses",
    "levelCap300Courses",
    "levelCap400Courses",
]


def load_json(path):
    if path == "-":
        return json.load(sys.stdin)
    with open(path, "r", encoding="utf-8") as handle:
        return json.load(handle)


def get_value(node, *keys):
    if not isinstance(node, dict):
        return None
    for key in keys:
        if key in node:
            return node[key]
    lower_map = {k.lower(): k for k in node.keys()}
    for key in keys:
        lower = key.lower()
        if lower in lower_map:
            return node[lower_map[lower]]
    return None


def matches(node, pattern):
    if pattern is None:
        return True
    haystack = " ".join(
        str(get_value(node, k) or "")
        for k in ["name", "kind", "notes", "footnoteText", "sourceRef"]
    )
    return bool(pattern.search(haystack))


def subtree_matches(node, pattern):
    if matches(node, pattern):
        return True
    for child in node.get("children") or []:
        if subtree_matches(child, pattern):
            return True
    return False


def truncate(text, limit):
    if text is None:
        return None
    if limit <= 0 or len(text) <= limit:
        return text
    return text[: max(0, limit - 3)] + "..."


def build_suffix(node, args):
    info = []
    n_required = get_value(node, "nRequired", "nrequired")
    if n_required is not None:
        info.append(f"n={n_required}")
    credit_min = get_value(node, "creditMin")
    credit_max = get_value(node, "creditMax")
    if credit_min is not None or credit_max is not None:
        info.append(f"credits={credit_min}..{credit_max}")
    level_min = get_value(node, "levelMin")
    if level_min is not None:
        info.append(f"level>={level_min}")
    for key in CAP_KEYS:
        value = get_value(node, key)
        if value is not None:
            info.append(f"{key}={value}")
    if args.show_notes:
        notes = get_value(node, "notes")
        name = get_value(node, "name")
        if notes and notes != name:
            info.append(f"notes={truncate(notes, args.notes_limit)}")
    if args.show_source:
        source = get_value(node, "sourceRef")
        if source:
            info.append(f"sourceRef={source}")
    if not info:
        return ""
    return " [" + ", ".join(info) + "]"


def print_tree(node, args, pattern, indent=0):
    if args.max_depth is not None and indent > args.max_depth:
        return
    if not subtree_matches(node, pattern):
        return
    kind = get_value(node, "kind") or "(unknown)"
    name = get_value(node, "name") or ""
    print("  " * indent + f"- {kind}: {name}{build_suffix(node, args)}")
    for child in node.get("children") or []:
        print_tree(child, args, pattern, indent + 1)


def main():
    parser = argparse.ArgumentParser(
        description="Pretty-print a parsed requirement tree JSON file."
    )
    parser.add_argument(
        "path",
        help="Path to *.expected.json (or '-' to read from stdin).",
    )
    parser.add_argument(
        "--max-depth",
        type=int,
        default=None,
        help="Limit tree depth (0 shows only the root).",
    )
    parser.add_argument(
        "--filter",
        default=None,
        help="Regex to filter nodes by name/kind/notes/sourceRef.",
    )
    parser.add_argument(
        "--show-notes",
        action="store_true",
        help="Include notes text in the output (truncated).",
    )
    parser.add_argument(
        "--notes-limit",
        type=int,
        default=160,
        help="Max characters for notes when --show-notes is used (default: 160).",
    )
    parser.add_argument(
        "--show-source",
        action="store_true",
        help="Include sourceRef in the output.",
    )
    args = parser.parse_args()

    data = load_json(args.path)
    pattern = re.compile(args.filter, re.IGNORECASE) if args.filter else None
    print_tree(data, args, pattern)


if __name__ == "__main__":
    main()
